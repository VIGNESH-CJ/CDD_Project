# AI Foodie Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Foodie"
APP_DESCRIPTION="Smart Food. Smarter Choices. - Intelligent Food Ordering & Restaurant Management"
SECRET_KEY="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite file for immediate zero-friction out-of-the-box local run
# When MySQL container or server is active, set:
# DATABASE_URL=mysql+pymysql://aifoodie_user:aifoodie_pass@localhost:3306/aifoodie_db
DATABASE_URL=sqlite:///./database/aifoodie.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=aifoodie_user
MYSQL_PASSWORD=aifoodie_pass
MYSQL_DATABASE=aifoodie_db

# Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS settings
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Optional LLM Key (Graceful Rule-Based / Local ML Fallback is fully active if left blank)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Payment Configuration
# sandbox: demo checkout with no real money movement
# stripe: Stripe Checkout test/live integration; requires STRIPE_SECRET_KEY
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
PUBLIC_BASE_URL=http://127.0.0.1:8000
